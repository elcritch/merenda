(.nif27)
(stylesheet
  (tokens
    (accent (hexColor 0x82_9f_ff)))
  (rule "#root, #about-content"#Quoted CSS ids need no hash escapes#
    (background (hexColor 0x181e29)))
  (rule "#preferences"
    (background (hexColor 0x222c3c)))
  (rule (role label)
    (color "#eef2fc")
    (fontSize 0xE px))
  (rule (match (role label) (class "label-title"))
    (fontSize 0o34 px))
  (rule (match (role label) (class eyebrow))
    (color (hexColor 0xa5baff))
    (fontSize 11 px))
  (rule (match (role label) (class muted))
    (color (hexColor 0xaebbd0))
    (fontSize 13 px))
  (rule (match (role label) (class "field-label"))
    (color (hexColor 0xc4cfe2))
    (fontSize 13 px))
  (rule (any (id name) (id language) (id theme))
    (background (hexColor 0x161e2b))
    (color (hexColor 0xeef2fc))
    (borderColor (hexColor 0x465674))
    (borderWidth 0b1 px)
    (borderRadius 7 px)
    (padding 9 px 12 px)
    (fontSize 14 px)
    (nimkitChrome flatTransparent)
    (nimkitFocusRingColor (var accent)))
  (rule (any (id language) (id theme))
    (boxShadow none)
    (nimkitChrome default)
    (nimkitIndicatorFill (hexColor 0x2b374c))
    (nimkitMarkColor (hexColor 0xdce5f5)))
  (rule
    (any
      (match (id language) (state hover))
      (match (id language) (state open))
      (match (id theme) (state hover))
      (match (id theme) (state open)))
    (nimkitIndicatorFill (hexColor 0x35445e)))
  (rule (any (match (id language) (state open)) (match (id theme) (state open)))
    (borderColor (var accent)))
  (rule (role comboBoxItem)
    (background (hexColor 0x222c3c))
    (color (hexColor 0xeef2fc)))
  (rule (match (role comboBoxItem) (state highlighted))
    (background (hexColor 0x35445e)))
  (rule (match (role comboBoxItem) (state selected))
    (background (var accent))
    (color (hexColor 0x101a30)))
  (rule (role checkbox)
    (color (hexColor 0xdce5f5))
    (fontSize 14 px)
    (nimkitIndicatorSize 18 px)
    (nimkitIndicatorSpacing 9 px))
  (rule (role button)
    (background (hexColor 0x2b374c))
    (color (hexColor 0xdce5f5))
    (borderColor (hexColor 0x465674))
    (borderWidth 1 px)
    (borderRadius 7 px)
    (padding 9 px 16 px)
    (fontSize 14 px)
    (nimkitChrome flatTransparent))
  (rule "button:hover"
    (background (hexColor 0x35445e)))
  (rule "button:pressed"
    (background (hexColor 0x202b3c)))
  (rule (match (role button) (class primary))
    (background (var accent))
    (color (hexColor 0x101a30))
    (borderColor (var accent)))
  (rule (match (role button) (class primary) (state hover))
    (background (hexColor 0x9ab1ff)))
  (rule (match (role button) (class primary) (state pressed))
    (background (hexColor 0x6583dc)))
  (rule (role progressIndicator)
    (background (hexColor 0x303e55))
    (nimkitHighlightFill (var accent))))
