(.nif27)
(stylesheet
  (tokens
    (accent (hexColor "829fff")))
  (rule (any (id root) (id "about-content"))
    (background (hexColor "181e29")))
  (rule (id preferences)
    (background (hexColor "222c3c")))
  (rule (role label)
    (color (hexColor "eef2fc"))
    (fontSize 14 px))
  (rule (match (role label) (class "label-title"))
    (fontSize 28 px))
  (rule (match (role label) (class eyebrow))
    (color (hexColor "a5baff"))
    (fontSize 11 px))
  (rule (match (role label) (class muted))
    (color (hexColor "aebbd0"))
    (fontSize 13 px))
  (rule (match (role label) (class "field-label"))
    (color (hexColor "c4cfe2"))
    (fontSize 13 px))
  (rule (any (id name) (id language) (id theme))
    (background (hexColor "161e2b"))
    (color (hexColor "eef2fc"))
    (borderColor (hexColor "465674"))
    (borderWidth 1 px)
    (borderRadius 7 px)
    (padding 9 px 12 px)
    (fontSize 14 px)
    (nimkitChrome flatTransparent)
    (nimkitFocusRingColor (var accent)))
  (rule (any (id language) (id theme))
    (boxShadow none)
    (nimkitChrome default)
    (nimkitIndicatorFill (hexColor "2b374c"))
    (nimkitMarkColor (hexColor "dce5f5")))
  (rule
    (any
      (match (id language) (state hover))
      (match (id language) (state open))
      (match (id theme) (state hover))
      (match (id theme) (state open)))
    (nimkitIndicatorFill (hexColor "35445e")))
  (rule (any (match (id language) (state open)) (match (id theme) (state open)))
    (borderColor (var accent)))
  (rule (role comboBoxItem)
    (background (hexColor "222c3c"))
    (color (hexColor "eef2fc")))
  (rule (match (role comboBoxItem) (state highlighted))
    (background (hexColor "35445e")))
  (rule (match (role comboBoxItem) (state selected))
    (background (var accent))
    (color (hexColor "101a30")))
  (rule (role checkbox)
    (color (hexColor "dce5f5"))
    (fontSize 14 px)
    (nimkitIndicatorSize 18 px)
    (nimkitIndicatorSpacing 9 px))
  (rule (role button)
    (background (hexColor "2b374c"))
    (color (hexColor "dce5f5"))
    (borderColor (hexColor "465674"))
    (borderWidth 1 px)
    (borderRadius 7 px)
    (padding 9 px 16 px)
    (fontSize 14 px)
    (nimkitChrome flatTransparent))
  (rule (match (role button) (state hover))
    (background (hexColor "35445e")))
  (rule (match (role button) (state pressed))
    (background (hexColor "202b3c")))
  (rule (match (role button) (class primary))
    (background (var accent))
    (color (hexColor "101a30"))
    (borderColor (var accent)))
  (rule (match (role button) (class primary) (state hover))
    (background (hexColor "9ab1ff")))
  (rule (match (role button) (class primary) (state pressed))
    (background (hexColor "6583dc")))
  (rule (role progressIndicator)
    (background (hexColor "303e55"))
    (nimkitHighlightFill (var accent))))
