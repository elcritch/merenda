{
  "title": "Markdown mixed line-break layout allocation churn",
  "baseRevision": "385a01c7",
  "afterChange": "Only src/merenda/nimkit/drawing/drawing.nim changed in an otherwise identical 385a01c7 detached worktree.",
  "platform": "macOS 15.7.9 arm64, Nim 2.4.0",
  "workload": "GFM table with 500 body rows, 52,371 source UTF-8 bytes and 90,107 rendered runes; initial layout and firstRender checkpoint, before resize. The process also includes startup, fonts, theme and UI/background layout.",
  "method": "One fresh process per version with MallocStackLogging=1; tracked markdownallocationprobe.nim checkpoint; leaks --fullStackHistory --outputGraph and malloc_history -highWaterMark -callTree -invert -ignoreThreads -consolidateAllBySymbol, plus live call tree. Nim c -d:release --mm:arc, same Atlas dependencies and config; classic backend matches prior trace and avoids IC rescheduling failure.",
  "buildCommand": "nim c -d:release --mm:arc --nimcache:<separate-cache> --out:<binary> tests/benchmarks/markdownallocationprobe.nim",
  "captureCommand": "python3 tests/benchmarks/capture_allocations.py markdown <binary> <fresh-prefix> table view 500",
  "harness": {
    "path": "tests/benchmarks/markdownallocationprobe.nim",
    "sha256": "40cc040bc837f2e8ebee9f68031837c3b8c3d32797bcb17501bde574ba24ed68"
  },
  "limitations": [
    "One traced sample per version. Stack logging changes memory and timing.",
    "Apple cumulative heap+VM request accounting is neither retained memory nor bytes necessarily physically copied; the independent allEvents sum includes VM and realloc entries and need not equal the tool header.",
    "The firstRender graph includes startup and global caches; later resized/released records in target log occur after graph capture.",
    "Stackless allocations and VM regions reported separately by malloc_history are excluded from attributed stack totals.",
    "The fix removes per-paragraph whole-arrangement copies, not every arrangement copy: a separate result initialization copy remains in the after peak tree."
  ],
