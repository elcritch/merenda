# Static FigDraw caches parsed fonts and reference bookkeeping in Nim threadvars.
# Nim ARC/ORC does not destroy these bounded, per-worker caches on thread exit.
# Fontconfig and Chronicles also retain one-time state while loading those fonts.
# Keep leak detection enabled for all other ownership-test allocations.
leak:drawing::defaultFont
leak:imgutils::retainFontRefId
leak:typefaces::registerTypeface
leak:libfontconfig.so
leak:outputs::memoryOutput
leak:times::newTimezone

# The native-renderer exception test initializes FigDraw's OpenGL shaders.
# FigDraw frees each CString array without freeing its copied source strings.
leak:shaders::compileShaderFiles

# Siwin's X11 window allocates three clipboard wrappers that remain after close.
# Restrict this suppression to that dependency's window-setup stack.
leak:window::setupWindow

# The NimKit text tests leave the shared application-lifetime worker pool and
# a deferred background-layout continuation for process teardown.
leak:backgroundworkers::nimkitWorkerPool
leak:scheduleBackgroundTextLayout
